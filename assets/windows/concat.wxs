<?xml version="1.0" encoding="UTF-8"?>
<!--
  Concat's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.8 -d Root=C:\...\Concat
              -d Stage=C:\...\stage\Concat-0.2.8-windows-x86_64
              -o stage\Concat-0.2.8-windows-x86_64.msi assets\windows\concat.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="Komunta"
           Manufacturer="Komunikia (fork de Concat)"
           Version="$(var.Version)"
           UpgradeCode="AB333A3C-BD5E-4744-950C-2BA2E9D3581D"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Komunta is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="concat.ico" SourceFile="$(var.Root)\assets\icons\concat.ico" />
    <Property Id="ARPPRODUCTICON" Value="concat.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Anchorquery/komunta" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Komunta" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="Komunta" />
    </StandardDirectory>

    <Feature Id="Main" Title="Komunta" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="E987F427-155D-4EB3-A14B-FE7CCB236DDF">
      <Shortcut Id="StartMenuShortcut"
                Name="Komunta"
                Description="Video editor"
                Target="[INSTALLFOLDER]concat.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="concat.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Komunta" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
