// Komunta's Montaje pane. A project with no montage offers one ("Montar
// con IA"); a montage under way shows its phases; and a montaged project
// shows its plan, read as a script rather than as JSON. One card per take, in order: what is said,
// word by word - a word clicked is cut, struck through, and clicked again
// comes back - then the captions that go over it, editable in place, and
// the B-roll laid on it. Takes move up and down and go. Nothing touches the
// timelines until "Crear versión con mis cambios", which lays the edited
// plan out again, with no AI, as a new timeline beside the old ones. A
// short guide, four steps, explains all this the first time a montage is
// opened and from the help button after that.
//
// The state is all Rust's (`panes::guion`), in the `GuionPanel` global, so
// two seats showing the script are one script.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { IconButton } from "../primitives/panel.slint";
import { Button, Field, Progress } from "../primitives/modal.slint";
import { Notice, PhaseRow } from "../montaje.slint";
import { Pane, PaneHeader, PaneScroll } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";

/// One word of a take.
export struct GuionWordData {
    take: int,
    /// Its index in the clip's transcript.
    i: int,
    text: string,
    /// Cut from the video.
    cut: bool,
    /// A filler the AI would cut ("eh", "o sea"...).
    filler: bool,
}

/// A line of words, as wide as the pane: Slint has no flowing layout, so
/// Rust breaks the take into lines by the width the pane reports.
export struct GuionRowData {
    words: [GuionWordData],
}

/// A caption or a piece of B-roll, by its index in the plan.
export struct GuionChipData {
    index: int,
    text: string,
    /// Its style or its effect, dim beside it.
    note: string,
}

/// One take.
export struct GuionBlockData {
    take: int,
    /// The clip's name in the material.
    clip: string,
    /// 0 spoken, 1 sound only, 2 a shot without words.
    kind: int,
    /// "0:12".
    duration: string,
    rows: [GuionRowData],
    captions: [GuionChipData],
    resources: [GuionChipData],
    first: bool,
    last: bool,
}

/// Something the quality check found in the plan.
export struct GuionWarningData {
    /// The warning broken into lines by Rust, the way a block's words are:
    /// a wrapped text in a layout leaves the card shorter than what it
    /// shows.
    lines: [string],
    /// The AI could put it right on a second pass.
    fixable: bool,
}

export global GuionPanel {
    /// The open project was made by a montage, and its plan was found.
    in property <bool> linked;
    in property <[GuionBlockData]> blocks;
    /// What the quality check finds in the plan as edited.
    in property <[GuionWarningData]> warnings;
    /// "4 tomas · 0:42 · versión 2".
    in property <string> summary;
    /// There are edits not yet applied.
    in property <bool> dirty;
    /// "Crear versión con mis cambios" is working.
    in property <bool> busy;
    /// What happened last, or why not.
    in property <string> status;

    /// The pane is this many characters wide, near enough.
    callback resized(columns: int);
    callback word-toggled(take: int, i: int);
    callback take-removed(take: int);
    callback take-moved(take: int, by: int);
    callback caption-edited(index: int, text: string);
    callback caption-removed(index: int);
    callback resource-removed(index: int);
    /// Back to the plan as it was last applied.
    callback revert();
    callback apply();

    /// A montage with AI is under way on this project.
    in property <bool> running;
    /// Its phase (0 reading ... 4 laying out) and how far into it.
    in property <int> phase;
    in property <float> progress;
    in property <string> message;
    /// Why the last montage did not happen.
    in property <string> error;
    /// "Armar montaje": the wizard.
    callback montage();
    /// "Rehacer…": the sheet, as the last montage was asked.
    callback redo();
    callback cancel();
    /// The error read.
    callback dismiss();

    /// The guide's step, 0 to `guide-steps` - 1; -1 is the guide closed.
    in property <int> guide: -1;
    out property <int> guide-steps: 4;
    callback guide-next();
    callback guide-back();
    /// "Saltar" or "Entendido": the guide is closed and not offered again
    /// by itself.
    callback guide-close();
    /// The help button: the guide from its first step.
    callback guide-open();
}

/// A word: clicked, it is cut or comes back.
component Word inherits Rectangle {
    in property <GuionWordData> word;

    width: label.preferred-width + 6px;
    height: 22px;
    border-radius: Theme.r-xs;
    background: touch.has-hover ? Theme.field-hover : Colors.transparent;

    label := Text {
        x: 3px;
        text: root.word.text;
        color: root.word.cut ? Theme.fg-dim
            : root.word.filler ? Theme.fg-muted
            : Theme.fg;
        font-size: Theme.fs;
        font-italic: root.word.filler;
        vertical-alignment: center;
    }

    // Slint has no strike-through: a rule across the word does it.
    if root.word.cut: Rectangle {
        x: 2px;
        y: parent.height / 2;
        width: parent.width - 4px;
        height: 1.5px;
        background: Theme.danger;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { GuionPanel.word-toggled(root.word.take, root.word.i); }
    }
}

/// The small title over a list in a card.
component Label inherits Text {
    color: Theme.fg-dim;
    font-size: Theme.fs-xs;
    font-weight: Theme.weight-title;
}

component Block inherits Rectangle {
    in property <GuionBlockData> block;
    in property <bool> busy;

    border-radius: Theme.r;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // Which take, from which clip, how long, and the three moves.
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: self.height / 2;
                background: Theme.accent-soft;
                Text {
                    text: root.block.take + 1;
                    color: Theme.accent;
                    font-size: Theme.fs-sm;
                    font-weight: Theme.weight-title;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.block.clip;
                color: Theme.fg-muted;
                font-family: Theme.font-technical;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: root.block.kind == 1 ? I18n.t("guion.soundOnly")
                    : root.block.kind == 2 ? I18n.t("guion.shot")
                    : I18n.t("guion.spoken");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }

            Text {
                text: root.block.duration;
                color: Theme.fg-muted;
                font-family: Theme.font-technical;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
            }

            IconButton {
                glyph: Glyph.chevron-up;
                enabled: !root.block.first && !root.busy;
                label: I18n.t("guion.moveUp");
                clicked => { GuionPanel.take-moved(root.block.take, -1); }
            }

            IconButton {
                glyph: Glyph.chevron-down;
                enabled: !root.block.last && !root.busy;
                label: I18n.t("guion.moveDown");
                clicked => { GuionPanel.take-moved(root.block.take, 1); }
            }

            IconButton {
                glyph: Glyph.trash;
                danger: true;
                enabled: !root.busy;
                label: I18n.t("guion.removeTake");
                clicked => { GuionPanel.take-removed(root.block.take); }
            }
        }

        // What is said, a line at a time.
        if root.block.rows.length > 0: VerticalLayout {
            spacing: 0px;
            for row in root.block.rows: HorizontalLayout {
                alignment: start;
                spacing: 0px;
                for word in row.words: Word {
                    word: word;
                }
            }
        }

        if root.block.rows.length == 0: Text {
            text: I18n.t("guion.noWords");
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            font-italic: true;
        }

        if root.block.captions.length > 0: VerticalLayout {
            spacing: 4px;

            Label { text: I18n.upper("guion.captions"); }

            for caption in root.block.captions: HorizontalLayout {
                spacing: 6px;

                Field {
                    value: caption.text;
                    edited(text) => { GuionPanel.caption-edited(caption.index, text); }
                }

                Text {
                    text: caption.note;
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }

                IconButton {
                    glyph: Glyph.close;
                    enabled: !root.busy;
                    label: I18n.t("guion.removeCaption");
                    clicked => { GuionPanel.caption-removed(caption.index); }
                }
            }
        }

        if root.block.resources.length > 0: VerticalLayout {
            spacing: 4px;

            Label { text: I18n.upper("guion.resources"); }

            for resource in root.block.resources: HorizontalLayout {
                spacing: 6px;

                VerticalLayout {
                    alignment: center;
                    Icon {
                        glyph: Glyph.film;
                        size: 12px;
                        tint: Theme.fg-muted;
                    }
                }

                Text {
                    horizontal-stretch: 1;
                    text: resource.text;
                    color: Theme.fg;
                    font-family: Theme.font-technical;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: resource.note;
                    color: Theme.fg-dim;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                }

                IconButton {
                    glyph: Glyph.close;
                    enabled: !root.busy;
                    label: I18n.t("guion.removeResource");
                    clicked => { GuionPanel.resource-removed(resource.index); }
                }
            }
        }
    }
}

// The quality check of the plan as it stands: what the team should look
// at before applying it, the ones the AI could fix marked as such.
component Review inherits Rectangle {
    in property <[GuionWarningData]> warnings;

    border-radius: Theme.r;
    background: root.warnings.length > 0 ? Theme.accent-soft : transparent;
    border-width: 1px;
    border-color: Theme.line;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;

            VerticalLayout {
                alignment: center;
                Icon {
                    glyph: root.warnings.length > 0 ? Glyph.info : Glyph.check;
                    size: 12px;
                    tint: root.warnings.length > 0 ? Theme.accent : Theme.fg-dim;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.warnings.length > 0
                    ? I18n.t1("guion.reviewCount", "" + root.warnings.length)
                    : I18n.t("guion.reviewClean");
                color: root.warnings.length > 0 ? Theme.fg : Theme.fg-dim;
                font-size: Theme.fs-sm;
                font-weight: root.warnings.length > 0 ? Theme.weight-title : 400;
                vertical-alignment: center;
            }
        }

        for warning in root.warnings: VerticalLayout {
            for line in warning.lines: Text {
                text: line;
                color: Theme.fg;
                font-size: Theme.fs-sm;
            }

            if warning.fixable: Text {
                text: I18n.t("guion.reviewFixable");
                color: Theme.fg-dim;
                font-size: Theme.fs-xs;
            }
        }
    }
}

// The script bar's pieces, laid out in one row or stacked as the pane's
// width allows.
component BarSummary inherits Text {
    text: GuionPanel.status != "" ? GuionPanel.status : GuionPanel.summary;
    color: Theme.fg-muted;
    font-size: Theme.fs-sm;
    vertical-alignment: center;
    overflow: elide;
}

component RedoButton inherits Button {
    label: I18n.t("montaje.redo");
    tip: I18n.t("guion.redoTip");
    glyph: Glyph.sparkle;
    ghost: true;
    enabled: !GuionPanel.busy;
    clicked => { GuionPanel.redo(); }
}

component RevertButton inherits Button {
    label: I18n.t("guion.revert");
    tip: I18n.t("guion.revertTip");
    ghost: true;
    enabled: GuionPanel.dirty && !GuionPanel.busy;
    clicked => { GuionPanel.revert(); }
}

// No spark on it: this one does not ask the AI for anything.
component ApplyButton inherits Button {
    label: GuionPanel.busy ? I18n.t("guion.applying") : I18n.t("guion.apply");
    tip: I18n.t("guion.applyTip");
    glyph: Glyph.plus;
    primary: true;
    enabled: !GuionPanel.busy;
    clicked => { GuionPanel.apply(); }
}

component GuideButton inherits IconButton {
    glyph: Glyph.help;
    label: I18n.t("guion.guideOpen");
    clicked => { GuionPanel.guide-open(); }
}

// The guide: a few steps, one at a time, on what the panel is and what
// each button does. It sits over the takes, inside the pane, so the
// buttons it speaks of are in sight.
component Guide inherits Rectangle {
    function title(step: int) -> string {
        step == 0 ? I18n.t("guion.guide1Title")
            : step == 1 ? I18n.t("guion.guide2Title")
            : step == 2 ? I18n.t("guion.guide3Title")
            : I18n.t("guion.guide4Title")
    }
    function body(step: int) -> string {
        step == 0 ? I18n.t("guion.guide1Body")
            : step == 1 ? I18n.t("guion.guide2Body")
            : step == 2 ? I18n.t("guion.guide3Body")
            : I18n.t("guion.guide4Body")
    }
    property <bool> last: GuionPanel.guide >= GuionPanel.guide-steps - 1;

    border-radius: Theme.r;
    background: Theme.accent-soft;
    border-width: 1px;
    border-color: Theme.accent;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Icon {
                    glyph: Glyph.help;
                    size: 14px;
                    tint: Theme.accent;
                }
            }

            Text {
                horizontal-stretch: 1;
                text: I18n.t2("guion.guideCounter",
                    "" + (GuionPanel.guide + 1), "" + GuionPanel.guide-steps);
                color: Theme.accent;
                font-size: Theme.fs-sm;
                font-weight: Theme.weight-title;
                vertical-alignment: center;
            }

            for n in GuionPanel.guide-steps: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: n == GuionPanel.guide ? Theme.accent : Theme.line-strong;
                }
            }
        }

        Text {
            text: title(GuionPanel.guide);
            color: Theme.fg;
            font-size: Theme.fs-lg;
            font-weight: Theme.weight-title;
            wrap: word-wrap;
        }

        Text {
            text: body(GuionPanel.guide);
            color: Theme.fg;
            font-size: Theme.fs;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            padding-top: 4px;

            Button {
                label: I18n.t("guion.guideSkip");
                ghost: true;
                clicked => { GuionPanel.guide-close(); }
            }

            Rectangle { horizontal-stretch: 1; }

            if GuionPanel.guide > 0: Button {
                label: I18n.t("guion.guideBack");
                clicked => { GuionPanel.guide-back(); }
            }

            Button {
                label: root.last ? I18n.t("guion.guideDone") : I18n.t("guion.guideNext");
                primary: true;
                clicked => {
                    if (root.last) {
                        GuionPanel.guide-close();
                    } else {
                        GuionPanel.guide-next();
                    }
                }
            }
        }
    }
}

// Edits are only a draft: said so, and said what turns them into
// something, for as long as there are some.
component DraftNote inherits Rectangle {
    border-radius: Theme.r;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line-strong;

    HorizontalLayout {
        padding: 10px;
        spacing: 8px;

        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Icon {
                glyph: Glyph.info;
                size: 12px;
                tint: Theme.accent;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: I18n.t("guion.draft");
            color: Theme.fg;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
        }
    }
}

export component GuionPane inherits Pane {
    in property <int> pane-seat;
    in property <bool> pane-removable;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();

    // About how many characters fit across, at the body's size, for Rust
    // to break the takes into lines by.
    changed width => {
        GuionPanel.resized(Math.max(16, Math.floor((self.width - 44px) / 7.2px)));
    }
    init => {
        GuionPanel.resized(Math.max(16, Math.floor((self.width - 44px) / 7.2px)));
    }

    PaneHeader {
        title: I18n.t("guion.title");

        VerticalLayout {
            alignment: center;
            PaneSwitcher {
                kind: PaneKind.guion;
                seat: root.pane-seat;
                removable: root.pane-removable;
                picked(kind) => { root.pane-picked(kind); }
                removed => { root.pane-removed(); }
            }
        }
    }

    // ── a montage under way ──────────────────────────────────────────
    if GuionPanel.running: VerticalLayout {
        vertical-stretch: 1;
        padding: 18px;
        spacing: 4px;
        alignment: start;

        Text {
            text: I18n.t("montaje.running");
            color: Theme.fg;
            font-size: Theme.fs-lg;
            font-weight: Theme.weight-title;
        }

        Rectangle { height: 8px; }

        for label[index] in [
            I18n.t("montaje.phaseRead"),
            I18n.t("montaje.phaseAnalyse"),
            I18n.t("montaje.phaseDescribe"),
            I18n.t("montaje.phasePlan"),
            I18n.t("montaje.phaseLayout"),
        ]: PhaseRow {
            label: label;
            state: index < GuionPanel.phase ? 1 : index == GuionPanel.phase ? 0 : -1;
        }

        Rectangle { height: 12px; }

        Progress {
            value: (GuionPanel.phase + GuionPanel.progress) / 5;
            live: true;
        }

        Rectangle { height: 6px; }

        Text {
            text: GuionPanel.message;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            font-family: Theme.font-technical;
            overflow: elide;
        }

        Rectangle { height: 12px; }

        HorizontalLayout {
            spacing: 12px;

            Button {
                label: I18n.t("common.cancel");
                ghost: true;
                clicked => { GuionPanel.cancel(); }
            }

            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: I18n.t("montaje.takesMinutes");
                color: Theme.fg-dim;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }
    }

    // ── why the last one did not happen ──────────────────────────────
    if !GuionPanel.running && GuionPanel.error != "": HorizontalLayout {
        padding: 10px;
        spacing: 8px;

        Notice {
            horizontal-stretch: 1;
            text: GuionPanel.error;
        }

        VerticalLayout {
            alignment: start;
            IconButton {
                glyph: Glyph.close;
                label: I18n.t("montaje.dismiss");
                clicked => { GuionPanel.dismiss(); }
            }
        }
    }

    // ── no montage yet: the offer ────────────────────────────────────
    if !GuionPanel.running && !GuionPanel.linked: VerticalLayout {
        vertical-stretch: 1;
        padding: 24px;
        alignment: center;
        spacing: 10px;

        Icon {
            glyph: Glyph.sparkle;
            size: 20px;
            tint: Theme.fg-dim;
        }

        Text {
            text: I18n.t("guion.notMontage");
            color: Theme.fg-muted;
            font-size: Theme.fs;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            Button {
                label: I18n.t("montaje.build");
                glyph: Glyph.sparkle;
                primary: true;
                clicked => { GuionPanel.montage(); }
            }
        }
    }

    // One row while the summary, the help and the three buttons fit; under
    // that, the summary over Redo, Revert and the help, and Apply across
    // the pane on a line of its own. A narrow pane used to cut the buttons
    // off.
    if !GuionPanel.running && GuionPanel.linked: Rectangle {
        property <bool> roomy: self.width >= 760px;
        height: self.roomy ? 40px : stack.preferred-height + 1px;
        Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }

        Rectangle {
            visible: parent.roomy;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 8px;

                BarSummary { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; GuideButton { } }
                VerticalLayout { alignment: center; RedoButton { } }
                VerticalLayout { alignment: center; RevertButton { } }
                VerticalLayout { alignment: center; ApplyButton { } }
            }
        }

        Rectangle {
            visible: !parent.roomy;

            stack := VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                BarSummary { }
                HorizontalLayout {
                    spacing: 8px;
                    RedoButton { }
                    RevertButton { }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; GuideButton { } }
                }
                ApplyButton { block: true; }
            }
        }
    }

    if !GuionPanel.running && GuionPanel.linked: PaneScroll {
        vertical-stretch: 1;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            if GuionPanel.guide >= 0: Guide { }

            if GuionPanel.dirty && !GuionPanel.busy: DraftNote { }

            Review { warnings: GuionPanel.warnings; }

            for block in GuionPanel.blocks: Block {
                block: block;
                busy: GuionPanel.busy;
            }

            Text {
                text: I18n.t("guion.hint");
                color: Theme.fg-dim;
                font-size: Theme.fs-xs;
                wrap: word-wrap;
            }
        }
    }
}
