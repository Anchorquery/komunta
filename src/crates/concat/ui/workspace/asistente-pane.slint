// Komunta's assistant: a chat with an AI that edits the project on screen.
// Laid out the way agent panels are (Zed's, VS Code's, Claude's): the
// field pinned at the bottom of the pane, a card with the choices that
// shape the next turn under the words - the model, how much it thinks,
// the agent's mode - and the send button, which is Stop while a turn
// runs. The agent itself is picked at the top. The conversation reads
// upwards from the field, the newest line always in sight: the person's
// words in a bubble on the right, the assistant's with their markdown
// drawn under its mark and name, each tool it used a slim pill; while a turn runs,
// three dots and what the AI is doing close it. With nothing said yet,
// a few requests to start from. Everything one turn does is undone with one Ctrl+Z.
//
// The state is all Rust's (`panes::asistente`), in the `AsistentePanel`
// global, so two seats showing the chat are one chat.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { IconButton } from "../primitives/panel.slint";
import { Button } from "../primitives/modal.slint";
import { Select } from "../primitives/select.slint";
import { Pane, PaneHeader } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";

/// A paragraph of the assistant's words, or an item of a list in them.
export struct AsistenteBloqueData {
    /// Its words with their markdown read: bold, italics, code.
    texto: styled-text,
    /// How deep in the list it sits.
    nivel: int,
    /// "" for a paragraph; the bullet, or the number, of an item.
    marca: string,
    /// The room over it.
    arriba: length,
}

/// One thing said.
export struct AsistenteLineaData {
    /// 0 the person, 1 the assistant, 2 the window (a failure, a notice),
    /// 3 a tool the assistant used.
    quien: int,
    texto: string,
    /// The assistant's words piece by piece: Slint puts no room between
    /// paragraphs and hangs nothing under a bullet, so the pane does.
    rico: [AsistenteBloqueData],
    /// Small print under it: how long the turn took.
    meta: string,
}

/// A choice under the field: what it is about (0 the model, 1 how much
/// it thinks, 2 the agent's mode), its values and which it has.
export struct AsistenteOpcionData {
    faceta: int,
    valores: [string],
    actual: int,
}

/// One task of the agent's plan: 0 pending, 1 under way, 2 done.
export struct AsistenteTareaData {
    texto: string,
    estado: int,
}

export global AsistentePanel {
    in property <[AsistenteLineaData]> lines;
    /// The agent's plan, as it last wrote it.
    in property <[AsistenteTareaData]> plan;
    /// A call waits for the person's yes: what it is and what it will do.
    in property <bool> asking;
    in property <string> ask-title;
    in property <string> ask-detail;
    /// A turn is under way: nothing more is sent until it ends.
    in property <bool> busy;
    /// What the turn under way is doing.
    in property <string> status;
    /// The agents the pane can talk to, Komunta's own first, and which.
    in property <[string]> agents;
    in property <int> agent;
    /// The choices under the field, for that agent.
    in property <[AsistenteOpcionData]> options;

    /// The pane is on screen.
    callback shown();
    callback send(text: string);
    /// A new conversation.
    callback clear();
    /// The answer to the call waiting: yes or no.
    callback answer(yes: bool);
    /// Stops the turn under way after the tool that is running.
    callback stop();
    callback agent-chosen(index: int);
    /// The choice at `option` set to its value at `value`.
    callback option-chosen(option: int, value: int);
}

// The agent's plan, above the conversation: each task with its mark.
component Plan inherits Rectangle {
    in property <[AsistenteTareaData]> tareas;

    border-radius: Theme.r;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line;

    VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 4px;

        Text {
            text: I18n.t("asistente.plan");
            color: Theme.fg-dim;
            font-size: Theme.fs-xs;
            font-weight: 600;
        }

        for tarea in root.tareas: HorizontalLayout {
            spacing: 6px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: tarea.estado == 0 ? Theme.fg-dim : tarea.estado == 1 ? Theme.accent : Theme.green;
                    background: tarea.estado == 0 ? Colors.transparent : tarea.estado == 1 ? Theme.accent : Theme.green;
                }
            }

            Text {
                text: tarea.texto;
                color: tarea.estado == 2 ? Theme.fg-dim : Theme.fg;
                font-size: Theme.fs-lg;
                font-weight: tarea.estado == 1 ? 600 : 400;
                overflow: elide;
            }
        }
    }
}

// A call waiting for the person's yes: what it will do, and the two
// answers.
component Aprobar inherits Rectangle {
    in property <string> titulo;
    in property <string> detalle;
    callback answer(yes: bool);

    border-radius: Theme.r-lg;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.accent;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Text {
            text: root.titulo;
            color: Theme.fg;
            font-size: Theme.fs-lg;
            font-weight: 600;
            wrap: word-wrap;
        }

        Text {
            text: root.detalle;
            color: Theme.fg-muted;
            font-size: Theme.fs-lg;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 6px;

            Button {
                label: I18n.t("asistente.reject");
                ghost: true;
                clicked => { root.answer(false); }
            }

            Button {
                label: I18n.t("asistente.approve");
                primary: true;
                clicked => { root.answer(true); }
            }
        }
    }
}

// The conversation's measures, on a 4px rhythm.
global Medidas {
    out property <length> texto: Theme.fs-lg;
    /// The conversation's side padding.
    out property <length> lado: 14px;
    /// Inside the person's bubble.
    out property <length> relleno: 12px;
    /// How far the person's bubble stays from the left edge, at the least.
    out property <length> sangria: 36px;
    /// Room between turns, and between the lines of one turn.
    out property <length> entre-turnos: 20px;
    out property <length> en-turno: 10px;
    /// How far each level of a list sits in, and the room for an item's
    /// mark - a bullet, or a number of up to two figures.
    out property <length> nivel: 14px;
    out property <length> marca: 18px;
}

// The assistant's mark: a sparkle on the accent's wash.
component Avatar inherits Rectangle {
    in property <length> size: 22px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: Theme.accent-soft;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: Glyph.sparkle;
        size: root.size * 0.58;
        tint: Theme.accent;
    }
}

// Who speaks from here on: the agent's mark and name, over its turn.
component Cabecera inherits HorizontalLayout {
    in property <string> nombre;

    alignment: start;
    spacing: 8px;

    Avatar { }

    Text {
        text: root.nombre;
        color: Theme.fg;
        font-size: Theme.fs-lg;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// The conversation, held to its bottom edge: when it outgrows the pane the
// oldest lines go off the top, and the wheel brings them back.
component ChatScroll inherits Rectangle {
    // How tall the conversation is, read from where its end landed. Its
    // preferred height falls short: Slint measures each line of a `for` at
    // one line of text when it sums them, though it lays each out at the
    // width it gets - and the end of a long answer went under the field.
    property <length> alto: fin.y + content.padding-bottom;
    // How far up from the newest line the person has scrolled, clamped on
    // read so a shorter conversation cannot leave it past the top.
    property <length> overflow: Math.max(0px, root.alto - root.height);
    property <length> back;
    property <length> at: Math.min(root.overflow, Math.max(0px, root.back));

    clip: true;

    wheel := TouchArea {
        scroll-event(event) => {
            root.back = Math.min(root.overflow, Math.max(0px, root.at + event.delta-y));
            return EventResult.accept;
        }

        // Placed by hand, `x` and all: a child with an `x` is left out of
        // its parent's constraints, so the conversation's height does not
        // cap the pane's - it did, and the field rose to the middle of a
        // pane with little said.
        // Its own height stays the short one and nothing in it stretches,
        // so the lines run past it as tall as they are, and its end is
        // where they really end.
        content := VerticalLayout {
            x: 0;
            y: Math.min(0px, root.height - root.alto) + root.at;
            width: root.width;
            height: self.preferred-height;
            alignment: start;
            padding-left: Medidas.lado;
            padding-right: Medidas.lado;
            padding-top: 16px;
            padding-bottom: 20px;

            @children

            fin := Rectangle { height: 0px; }
        }
    }

    // The lines fade out at the edges instead of being cut: at the bottom
    // always, over the field; at the top once older lines are up there.
    Rectangle {
        y: root.height - self.height;
        height: 20px;
        background: @linear-gradient(180deg, Theme.panel.with-alpha(0) 0%, Theme.panel 100%);
    }

    if root.overflow > root.at + 1px: Rectangle {
        y: 0;
        height: 20px;
        background: @linear-gradient(180deg, Theme.panel 0%, Theme.panel.with-alpha(0) 100%);
    }

    // A slim bar at the right edge once there is more than fits: where the
    // lines on screen sit in the whole conversation. It firms up under the
    // pointer, and dragging anywhere along the edge scrolls.
    if root.overflow > 0: Rectangle {
        property <length> pista: root.height - 8px;
        property <length> largo: Math.max(28px, self.pista * root.height / root.alto);
        // From the top of the conversation to the top of the screen.
        property <length> desde-arriba: root.overflow - root.at;
        // Where the press began, and how far scrolled up it was then.
        property <length> agarre;
        property <length> al-agarrar;

        x: root.width - self.width;
        width: 12px;

        Rectangle {
            x: parent.width - self.width - 3px;
            y: 4px + (parent.pista - parent.largo) * parent.desde-arriba / root.overflow;
            width: barra.has-hover || barra.pressed ? 6px : 4px;
            height: parent.largo;
            border-radius: self.width / 2;
            background: barra.pressed ? Theme.fg-muted : barra.has-hover ? Theme.fg-dim : Theme.line-strong;
            animate width, background { duration: 150ms; easing: ease-out; }
        }

        barra := TouchArea {
            // Over the bar the wheel scrolls too.
            scroll-event(event) => {
                root.back = Math.min(root.overflow, Math.max(0px, root.at + event.delta-y));
                return EventResult.accept;
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    parent.agarre = self.mouse-y;
                    parent.al-agarrar = root.at;
                }
            }
            moved => {
                if (self.pressed && parent.pista > parent.largo) {
                    // The thumb goes down as the conversation goes up.
                    let bajada = (self.mouse-y - parent.agarre) * root.overflow / (parent.pista - parent.largo);
                    root.back = Math.min(root.overflow, Math.max(0px, parent.al-agarrar - bajada));
                }
            }
        }
    }
}

// The person's words: a bubble on the accent's wash at the right, as wide
// as they are up to most of the pane, its corner by the edge tucked in.
// Measured by hand, not by a layout: a layout sized the bubble for the
// words wrapped at one width and then wrapped them at a narrower one, so
// the last line ran into its bottom edge and the longest into its right.
component Persona inherits Rectangle {
    in property <AsistenteLineaData> line;

    // The words inside: as wide as they are unbroken - a pixel more, so
    // the widest line does not wrap on a rounding - up to the pane less
    // the indent on the left.
    property <length> interior: Math.max(0px, Math.min(
        medida.preferred-width + 1px,
        root.width - Medidas.sangria - 2 * Medidas.relleno));
    property <length> vertical: 8px;

    height: texto.preferred-height + 2 * root.vertical;

    medida := Text {
        text: root.line.texto;
        font-size: Medidas.texto;
        visible: false;
    }

    Rectangle {
        x: parent.width - self.width;
        y: 0px;
        width: root.interior + 2 * Medidas.relleno;
        height: parent.height;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        border-bottom-left-radius: 16px;
        border-bottom-right-radius: 4px;
        background: Theme.accent-soft;

        texto := Text {
            x: Medidas.relleno;
            y: root.vertical;
            width: root.interior;
            height: self.preferred-height;
            text: root.line.texto;
            color: Theme.fg;
            font-size: Medidas.texto;
            wrap: word-wrap;
        }
    }
}

// The assistant's words: no bubble, read across the pane - each paragraph
// with its room, each item of a list with its mark beside it and its lines
// hung under its words - with how long the turn took under them.
component Asistente inherits VerticalLayout {
    in property <AsistenteLineaData> line;

    spacing: 8px;

    VerticalLayout {
        // The words in a column of their own, the mark placed by hand in
        // the room left of them: beside the words in a row, the words were
        // measured as wide as the row, and a line that only just wrapped
        // was given no room and ran over what came under it.
        for bloque in root.line.rico: VerticalLayout {
            padding-top: bloque.arriba;
            padding-left: bloque.nivel * Medidas.nivel + (bloque.marca != "" ? Medidas.marca : 0px);

            // No height of its own: the mark hangs off it, into the room
            // the padding left.
            if bloque.marca != "": Rectangle {
                height: 0px;

                Text {
                    x: -Medidas.marca;
                    y: 0px;
                    text: bloque.marca;
                    color: Theme.fg-dim;
                    font-size: Medidas.texto;
                }
            }

            StyledText {
                text: bloque.texto;
                default-color: Theme.fg;
                default-font-size: Medidas.texto;
                link-color: Theme.accent;
            }
        }
    }

    if root.line.meta != "": Text {
        text: root.line.meta;
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
    }
}

// A tool the assistant used, ticked off: a slim pill with what it did.
component Accion inherits HorizontalLayout {
    in property <AsistenteLineaData> line;

    alignment: start;

    Rectangle {
        border-radius: 11px;
        background: Theme.field;

        HorizontalLayout {
            padding-left: 7px;
            padding-right: 10px;
            padding-top: 3px;
            padding-bottom: 3px;
            spacing: 6px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: Theme.green.with-alpha(0.18);

                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        glyph: Glyph.check;
                        size: 9px;
                        tint: Theme.green;
                    }
                }
            }

            Text {
                text: root.line.texto;
                color: Theme.fg-muted;
                font-size: Theme.fs;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// What the window says: a failure, on danger's wash.
component Aviso inherits Rectangle {
    in property <AsistenteLineaData> line;

    border-radius: Theme.r;
    background: Theme.danger-soft;
    border-width: 1px;
    border-color: Theme.danger-edge;

    HorizontalLayout {
        padding: 10px;
        spacing: 8px;

        VerticalLayout {
            alignment: start;
            Icon {
                glyph: Glyph.info;
                size: 14px;
                tint: Theme.danger;
            }
        }

        Text {
            text: root.line.texto;
            color: Theme.fg;
            font-size: Theme.fs-lg;
            wrap: word-wrap;
        }
    }
}

// The turn under way: three dots that breathe, and what the AI is doing.
component Escribiendo inherits HorizontalLayout {
    in property <string> status;

    property <duration> tick: animation-tick();

    alignment: start;
    spacing: 10px;

    HorizontalLayout {
        alignment: center;
        spacing: 4px;

        for i in 3: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.accent;
                opacity: 0.25 + 0.75 * Math.abs(Math.sin((root.tick / 1ms) * 0.18deg - i * 40deg));
            }
        }
    }

    Text {
        text: root.status;
        color: Theme.fg-muted;
        font-size: Theme.fs-lg;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A request to start from: one click sends it.
component Sugerencia inherits Rectangle {
    in property <string> text;
    callback send(text: string);

    min-height: 40px;
    border-radius: Theme.r-lg;
    background: touch.pressed ? Theme.field-active : touch.has-hover ? Theme.field-hover : Theme.field;
    animate background { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: touch.has-hover ? Theme.fg : Theme.fg-muted;
            font-size: Theme.fs-lg;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: Glyph.arrow-up-right;
                size: 13px;
                tint: touch.has-hover ? Theme.accent : Theme.fg-dim;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.send(root.text); }
    }
}

// Nothing said yet: the assistant's mark, a question, a line on how it
// works, and three requests to start from, in the middle of the pane
// above the field.
component Bienvenida inherits VerticalLayout {
    in property <bool> enabled: true;
    callback send(text: string);

    alignment: center;
    padding-left: Medidas.lado;
    padding-right: Medidas.lado;
    spacing: 10px;

    HorizontalLayout {
        alignment: start;
        padding-bottom: 4px;
        Avatar { size: 36px; }
    }

    Text {
        text: I18n.t("asistente.helloTitle");
        color: Theme.fg;
        font-size: 20px;
        font-weight: 600;
        wrap: word-wrap;
    }

    Text {
        text: I18n.t("asistente.hello");
        color: Theme.fg-muted;
        font-size: Theme.fs-lg;
        wrap: word-wrap;
    }

    VerticalLayout {
        padding-top: 8px;
        spacing: 6px;

        for sugerencia in [
            I18n.t("asistente.suggest1"),
            I18n.t("asistente.suggest2"),
            I18n.t("asistente.suggest3"),
        ]: Sugerencia {
            text: sugerencia;
            send(text) => {
                if (root.enabled) {
                    root.send(text);
                }
            }
        }
    }
}

// The send button: an arrow on the accent when there is something to
// send, a square that stops the turn while one runs.
component Enviar inherits Rectangle {
    in property <bool> listo;
    in property <bool> busy;
    callback send();
    callback stop();

    property <bool> activo: root.listo || root.busy;

    width: 30px;
    height: 30px;
    border-radius: self.width / 2;
    background: root.busy ? (touch.has-hover ? Theme.line-strong : Theme.raised)
        : !root.listo ? Colors.transparent
        : touch.has-hover ? Theme.accent-hover : Theme.accent;
    border-width: root.busy ? 1px : 0px;
    border-color: Theme.line-strong;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.busy ? Glyph.stop : Glyph.send;
        size: root.busy ? 12px : 15px;
        tint: root.busy ? Theme.fg : root.listo ? Theme.on-accent : Theme.fg-dim;
    }

    touch := TouchArea {
        mouse-cursor: root.activo ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.busy) {
                root.stop();
            } else if (root.listo) {
                root.send();
            }
        }
    }
}

// The field: a card at the bottom of the pane with the person's words -
// Enter sends, Shift+Enter starts a line - and under them the choices for
// the next turn and the send button. It grows with the words up to six
// lines or so. Words can be written while a turn runs; they go when it
// ends.
component Composer inherits Rectangle {
    in property <bool> busy;
    in property <[AsistenteOpcionData]> opciones;

    callback send(text: string);
    callback stop();
    callback chose(option: int, value: int);

    property <bool> listo: !root.busy && input.text != "";
    property <length> alto: Math.min(132px, Math.max(22px, input.preferred-height));

    function enviar() {
        if (root.listo) {
            root.send(input.text);
            input.text = "";
        }
    }

    vertical-stretch: 0;
    border-radius: Theme.r-lg;
    background: Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line-strong;

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 11px;
        padding-bottom: 8px;
        spacing: 8px;

        Rectangle {
            height: root.alto;
            clip: true;

            keys := FocusScope {
                focus-on-tab-navigation: false;

                // Enter sends; Shift+Enter is the field's own new line.
                capture-key-pressed(event) => {
                    if (event.text == Key.Return && !event.modifiers.shift) {
                        root.enviar();
                        return accept;
                    }
                    return reject;
                }

                input := TextInput {
                    x: 0;
                    y: 0;
                    width: parent.width - 4px;
                    height: Math.max(root.alto, self.preferred-height);
                    color: Theme.fg;
                    font-size: Theme.fs-xl;
                    single-line: false;
                    wrap: word-wrap;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                }
            }

            if input.text == "": Text {
                x: 0;
                y: 0;
                width: parent.width;
                text: I18n.t("asistente.placeholder");
                color: Theme.fg-dim;
                font-size: Theme.fs-xl;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 2px;

            for opcion[indice] in root.opciones: Select {
                flat: true;
                snug: true;
                height: 26px;
                min-width: 44px;
                max-width: self.natural-width;
                horizontal-stretch: 0;
                // How much it thinks and the mode wear a mark, not words:
                // the pane is narrow, and the model's name needs the room.
                // The words are in the list, and in the mark's tip.
                icons: opcion.faceta == 1 ? [Glyph.meter, Glyph.meter, Glyph.meter, Glyph.meter, Glyph.meter, Glyph.meter]
                    : opcion.faceta == 2 ? [Glyph.hand, Glyph.hand, Glyph.hand, Glyph.hand, Glyph.hand, Glyph.hand, Glyph.hand, Glyph.hand]
                    : [];
                options: opcion.valores;
                current: opcion.actual;
                enabled: !root.busy;
                changed(valor) => { root.chose(indice, valor); }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                Enviar {
                    listo: root.listo;
                    busy: root.busy;
                    send => { root.enviar(); }
                    stop => { root.stop(); }
                }
            }
        }
    }
}

export component AsistentePane inherits Pane {
    in property <int> pane-seat;
    in property <bool> pane-removable;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();

    init => { AsistentePanel.shown(); }

    // The agent picked at the top, where the title would be: it is what
    // the pane is.
    PaneHeader {
        title: "";

        VerticalLayout {
            alignment: center;
            Select {
                flat: true;
                snug: true;
                height: 28px;
                min-width: 60px;
                max-width: self.natural-width;
                horizontal-stretch: 0;
                options: AsistentePanel.agents;
                current: AsistentePanel.agent;
                enabled: !AsistentePanel.busy;
                changed(index) => { AsistentePanel.agent-chosen(index); }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Glyph.plus;
                label: I18n.t("asistente.clear");
                enabled: !AsistentePanel.busy;
                clicked => { AsistentePanel.clear(); }
            }
        }

        VerticalLayout {
            alignment: center;
            PaneSwitcher {
                kind: PaneKind.asistente;
                seat: root.pane-seat;
                removable: root.pane-removable;
                picked(kind) => { root.pane-picked(kind); }
                removed => { root.pane-removed(); }
            }
        }
    }

    if AsistentePanel.lines.length == 0 && !AsistentePanel.busy: Bienvenida {
        vertical-stretch: 1;
        send(text) => { AsistentePanel.send(text); }
    }

    if AsistentePanel.lines.length > 0 || AsistentePanel.busy: ChatScroll {
        vertical-stretch: 1;

        // Each turn of the assistant opens under its mark and name; turns
        // stand apart, the lines of one turn close together, a run of
        // tools closer still.
        for line[i] in AsistentePanel.lines: fila := VerticalLayout {
            property <int> antes: i > 0 ? AsistentePanel.lines[i - 1].quien : -1;
            property <bool> abre: line.quien != 0 && (i == 0 || fila.antes == 0);

            padding-top: i == 0 ? 0px
                : line.quien == 0 || fila.abre ? Medidas.entre-turnos
                : line.quien == 3 && fila.antes == 3 ? 4px
                : Medidas.en-turno;
            spacing: Medidas.en-turno;

            if fila.abre: Cabecera { nombre: AsistentePanel.agents[AsistentePanel.agent]; }
            if line.quien == 0: Persona { line: line; }
            if line.quien == 1: Asistente { line: line; }
            if line.quien == 2: Aviso { line: line; }
            if line.quien == 3: Accion { line: line; }
        }

        if AsistentePanel.busy: pensando := VerticalLayout {
            property <bool> abre: AsistentePanel.lines.length == 0
                || AsistentePanel.lines[AsistentePanel.lines.length - 1].quien == 0;

            padding-top: AsistentePanel.lines.length == 0 ? 0px : pensando.abre ? Medidas.entre-turnos : Medidas.en-turno;
            spacing: Medidas.en-turno;

            if pensando.abre: Cabecera { nombre: AsistentePanel.agents[AsistentePanel.agent]; }
            Escribiendo {
                status: AsistentePanel.status != "" ? AsistentePanel.status : I18n.t("asistente.thinking");
            }
        }
    }

    // Only as tall as what it holds: the conversation, or the welcome,
    // takes the rest of the pane.
    VerticalLayout {
        vertical-stretch: 0;
        padding: 10px;
        padding-top: 4px;
        spacing: 6px;

        if AsistentePanel.plan.length > 0: Plan {
            tareas: AsistentePanel.plan;
        }

        if AsistentePanel.asking: Aprobar {
            titulo: AsistentePanel.ask-title;
            detalle: AsistentePanel.ask-detail;
            answer(yes) => { AsistentePanel.answer(yes); }
        }

        Composer {
            busy: AsistentePanel.busy;
            opciones: AsistentePanel.options;
            send(text) => { AsistentePanel.send(text); }
            stop => { AsistentePanel.stop(); }
            chose(option, value) => { AsistentePanel.option-chosen(option, value); }
        }
    }
}
