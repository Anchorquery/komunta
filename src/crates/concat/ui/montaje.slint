// Komunta's montage with AI, which a project has rather than is: the
// "Montar con IA" section of New project (`MontajeSection`), and the sheet
// over an open project (`MontajeDialog`) - the material, what the video is
// for, the captions - for a first montage or to redo one. The run itself
// shows in the Montaje pane. Both wear the launch screen's clothes - the
// plain fields, the chip rows, the ink pill.
//
// The state is all Rust's (`panes::montaje`), published whole as
// `MontajeData`. Both report back through three callbacks: a text field
// changed, a choice changed, or an action was pressed, each by name, so the
// window does not grow a callback per field.

import { I18n } from "i18n.slint";
import { Theme } from "theme/theme.slint";
import { CopyChip, Modal, Progress } from "primitives/modal.slint";
import { Glyph, Icon } from "icons.slint";
import { Select } from "primitives/select.slint";
import { Focus } from "util.slint";
import { Chip, ChipOption, ChipRow, FormRow, LinkButton, PillButton, PlainInput } from "start.slint";

export struct MontajeData {
    /// The sheet is up.
    open: bool,
    /// The sheet redoes the project's montage.
    redo: bool,
    /// New project's "Montar con IA" is on.
    enabled: bool,
    /// 0 material, 1 what it is for, 2 captions and script.
    step: int,
    /// The material folder.
    material: string,
    /// "12 vídeos, 4 fotos, 1 documento", or why the folder will not do.
    material-note: string,
    /// "Automático" first: the AI tells the kind.
    recipe: int,
    recipes: [string],
    /// What the chosen recipe makes.
    recipe-note: string,
    /// "¿Qué quieres?", as typed.
    request: string,
    vertical: bool,
    wide: bool,
    square: bool,
    brand: int,
    /// "Sin marca" first, then the engine's kits.
    brands: [string],
    /// 0 detect, 1 Spanish, 2 Basque.
    language: int,
    /// 0 as the kind has it, 1 from the script, 2 from the voice, 3 key
    /// phrases, 4 none.
    captions: int,
    /// A script file outside the material; empty for none.
    script: string,
    /// The engine is where Settings says.
    engine-ok: bool,
    /// What is wrong with it when it is not, or which AI will plan.
    engine-note: string,
    /// A montage is under way.
    busy: bool,
    error: string,
}

// A switch drawn from Rust's state, as the inspector's is, but with no
// state of its own to fall out of step with it.
component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled();

    width: 30px;
    height: 17px;
    border-radius: Theme.r-sm;
    background: root.on ? Theme.accent : Theme.field-active;

    animate background { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        border-radius: Theme.r-xs;
        background: Theme.on-accent;

        animate x { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// The captions: as the kind has it, or one way for this video.
component CaptionsChoice inherits VerticalLayout {
    in property <int> current;
    in property <bool> narrow;
    callback changed(index: int);

    spacing: 6px;

    ChipRow {
        options: [
            { label: I18n.t("montaje.captionsByKind"), ratio: 0 },
            { label: I18n.t("montaje.captionsScript"), ratio: 0 },
            { label: I18n.t("montaje.captionsVoice"), ratio: 0 },
            { label: I18n.t("montaje.captionsKeys"), ratio: 0 },
            { label: I18n.t("montaje.captionsNone"), ratio: 0 },
        ];
        current: root.current;
        per-row: root.narrow ? 2 : 3;
        block: root.narrow;
        changed(index) => { root.changed(index); }
    }

    Text {
        text: root.current == 0 ? I18n.t("montaje.captionsByKindNote")
            : root.current == 1 ? I18n.t("montaje.captionsScriptNote")
            : root.current == 2 ? I18n.t("montaje.captionsVoiceNote")
            : root.current == 3 ? I18n.t("montaje.captionsKeysNote")
            : I18n.t("montaje.captionsNoneNote");
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
}

// The material folder, typed or chosen, with what is in it under it.
component MaterialField inherits VerticalLayout {
    in property <string> material;
    in property <string> note;
    callback edited(text: string);
    callback browse();

    spacing: 6px;

    HorizontalLayout {
        spacing: 12px;

        PlainInput {
            horizontal-stretch: 1;
            text: root.material;
            placeholder: I18n.t("montaje.materialPlaceholder");
            size: Theme.fs;
            face: Theme.font-technical;
            edited(text) => { root.edited(text); }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            LinkButton {
                label: I18n.t("start.choose");
                clicked => {
                    Focus.release();
                    root.browse();
                }
            }
        }
    }

    Text {
        text: root.note;
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
}

// The script file: none, or one outside the material.
component ScriptField inherits HorizontalLayout {
    in property <string> script;
    callback action(name: string);

    spacing: 12px;

    Text {
        horizontal-stretch: 1;
        vertical-alignment: center;
        text: root.script == "" ? I18n.t("montaje.scriptNone") : root.script;
        color: root.script == "" ? Theme.fg-dim : Theme.fg;
        font-size: Theme.fs;
        font-family: root.script == "" ? Theme.font : Theme.font-technical;
        wrap: word-wrap;
    }

    if root.script != "": VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        LinkButton {
            label: I18n.t("montaje.remove");
            clicked => { root.action("clear-script"); }
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        LinkButton {
            label: I18n.t("start.choose");
            clicked => { root.action("browse-script"); }
        }
    }
}

// The kind of video, with what it makes under it.
component KindField inherits VerticalLayout {
    in property <MontajeData> data;
    callback changed(index: int);

    spacing: 6px;

    Select {
        options: root.data.recipes;
        current: root.data.recipe;
        changed(index) => { root.changed(index); }
    }

    Text {
        text: root.data.recipe-note;
        color: Theme.fg-dim;
        font-size: Theme.fs-sm;
        wrap: word-wrap;
    }
}

// One phase of the run: a tick once done, a dot while under way, a ring
// before.
export component PhaseRow inherits HorizontalLayout {
    in property <string> label;
    /// -1 to come, 0 under way, 1 done.
    in property <int> state;

    spacing: 10px;
    height: 26px;

    Rectangle {
        width: 18px;
        height: 18px;
        y: (parent.height - self.height) / 2;
        border-radius: 9px;
        background: root.state == 1 ? Theme.accent : transparent;
        border-width: root.state == 1 ? 0px : 1.5px;
        border-color: root.state == 0 ? Theme.accent : Theme.line-strong;

        if root.state == 1: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            glyph: Glyph.check;
            size: 11px;
            tint: Theme.on-accent;
        }

        if root.state == 0: Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
        }
    }

    Text {
        vertical-alignment: center;
        text: root.label;
        color: root.state < 0 ? Theme.fg-dim : Theme.fg;
        font-size: Theme.fs-lg;
        font-weight: root.state == 0 ? Theme.weight-title : Theme.weight-body;
    }
}

// The three steps' names across the top, the current one in ink.
component Steps inherits HorizontalLayout {
    in property <int> current;

    spacing: 6px;
    alignment: start;

    for label[index] in [
        I18n.t("montaje.stepMaterial"),
        I18n.t("montaje.stepWhat"),
        I18n.t("montaje.stepCaptions"),
    ]: HorizontalLayout {
        spacing: 6px;

        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: index <= root.current ? Theme.accent : Theme.launch-raised;

            Text {
                text: "\{index + 1}";
                color: index <= root.current ? Theme.on-accent : Theme.fg-dim;
                font-size: Theme.fs-sm;
                font-weight: Theme.weight-title;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            vertical-alignment: center;
            text: label;
            color: index == root.current ? Theme.fg : Theme.fg-dim;
            font-size: Theme.fs;
            font-weight: index == root.current ? Theme.weight-title : Theme.weight-body;
        }

        if index < 2: Text {
            vertical-alignment: center;
            text: "  ·  ";
            color: Theme.fg-dim;
        }
    }
}

// A notice in the danger tone, wrapping to the whole error.
export component Notice inherits Rectangle {
    in property <string> text;

    height: row.preferred-height;
    border-radius: Theme.r;
    background: Theme.danger-soft;

    row := HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 8px;

        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            Icon {
                glyph: Glyph.info;
                size: 13px;
                tint: Theme.danger;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.danger;
            font-size: Theme.fs;
            wrap: word-wrap;
        }

        VerticalLayout {
            alignment: start;
            CopyChip {
                text: root.text;
            }
        }
    }
}

export component MontajeDialog inherits Modal {
    in property <MontajeData> data;

    /// A text field changed: "material", "request".
    callback text-edited(field: string, value: string);
    /// A choice changed: "recipe", "brand", "language", "captions", and
    /// "vertical", "wide", "square" as 0 or 1.
    callback choice-changed(field: string, value: int);
    /// "browse-material", "browse-script", "clear-script", "next", "back",
    /// "run", "settings".
    callback action(name: string);

    property <bool> narrow: root.width < 680px;
    property <bool> can-next: !root.data.busy && root.data.material != "";
    property <bool> can-run: root.can-next && root.data.engine-ok;

    open: root.data.open;
    title: root.data.redo ? I18n.t("montaje.redoTitle") : I18n.t("montaje.montage");
    glyph: Glyph.sparkle;
    surface-width: Math.min(660px, root.width - 32px);

    // The request box keeps its own copy while it has the caret, as the
    // plain fields do: a republish mid-word must not move it.
    property <string> request-draft;
    changed open => {
        if (root.open) {
            root.request-draft = root.data.request;
        }
    }

    VerticalLayout {
        padding-left: root.narrow ? 18px : 26px;
        padding-right: root.narrow ? 18px : 26px;
        padding-top: 16px;
        padding-bottom: 22px;

        Steps {
            current: root.data.step;
        }

        // ── 1. the material ──────────────────────────────────────────
        if root.data.step == 0: VerticalLayout {
            FormRow {
                label: I18n.upper("montaje.material");
                stacked: root.narrow;
                last: true;

                MaterialField {
                    material: root.data.material;
                    note: root.data.material-note;
                    edited(text) => { root.text-edited("material", text); }
                    browse => { root.action("browse-material"); }
                }
            }
        }

        // ── 2. what it is for ────────────────────────────────────────
        if root.data.step == 1: VerticalLayout {
            FormRow {
                label: I18n.upper("montaje.kind");
                stacked: root.narrow;

                KindField {
                    data: root.data;
                    changed(index) => { root.choice-changed("recipe", index); }
                }
            }

            FormRow {
                label: I18n.upper("montaje.request");
                stacked: root.narrow;

                Rectangle {
                    height: 96px;
                    border-radius: Theme.r;
                    background: Theme.launch-well;
                    border-width: 1px;
                    border-color: request.has-focus ? Theme.accent : Theme.line;
                    clip: true;

                    request := TextInput {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        text <=> root.request-draft;
                        color: Theme.fg;
                        font-size: Theme.fs;
                        single-line: false;
                        wrap: word-wrap;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.on-accent;
                        edited => { root.text-edited("request", self.text); }
                    }

                    if root.request-draft == "" && !request.has-focus: Text {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        text: I18n.t("montaje.requestPlaceholder");
                        color: Theme.fg-dim;
                        font-size: Theme.fs;
                        wrap: word-wrap;
                    }
                }
            }

            FormRow {
                label: I18n.upper("montaje.formats");
                stacked: root.narrow;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Chip {
                        label: I18n.t("montaje.vertical");
                        ratio: 9 / 16;
                        selected: root.data.vertical;
                        clicked => { root.choice-changed("vertical", root.data.vertical ? 0 : 1); }
                    }

                    Chip {
                        label: I18n.t("montaje.wide");
                        ratio: 16 / 9;
                        selected: root.data.wide;
                        clicked => { root.choice-changed("wide", root.data.wide ? 0 : 1); }
                    }

                    Chip {
                        label: I18n.t("montaje.square");
                        ratio: 1;
                        selected: root.data.square;
                        clicked => { root.choice-changed("square", root.data.square ? 0 : 1); }
                    }
                }
            }

            FormRow {
                label: I18n.upper("montaje.brand");
                stacked: root.narrow;
                last: true;

                HorizontalLayout {
                    alignment: start;
                    Select {
                        width: 240px;
                        options: root.data.brands;
                        current: root.data.brand;
                        changed(index) => { root.choice-changed("brand", index); }
                    }
                }
            }
        }

        // ── 3. captions and script ───────────────────────────────────
        if root.data.step == 2: VerticalLayout {
            FormRow {
                label: I18n.upper("montaje.captions");
                stacked: root.narrow;

                CaptionsChoice {
                    current: root.data.captions;
                    narrow: root.narrow;
                    changed(index) => { root.choice-changed("captions", index); }
                }
            }

            FormRow {
                label: I18n.upper("montaje.script");
                stacked: root.narrow;

                ScriptField {
                    script: root.data.script;
                    action(name) => { root.action(name); }
                }
            }

            FormRow {
                label: I18n.upper("montaje.language");
                stacked: root.narrow;
                last: true;

                ChipRow {
                    options: [
                        { label: I18n.t("montaje.languageDetect"), ratio: 0 },
                        { label: I18n.t("montaje.languageEs"), ratio: 0 },
                        { label: I18n.t("montaje.languageEu"), ratio: 0 },
                    ];
                    current: root.data.language;
                    changed(index) => { root.choice-changed("language", index); }
                }
            }
        }

        // The engine is not set up: say so where the button would be
        // pressed, with the way to Settings beside it.
        if !root.data.engine-ok: VerticalLayout {
            padding-top: 12px;

            HorizontalLayout {
                spacing: 12px;

                Notice {
                    horizontal-stretch: 1;
                    text: root.data.engine-note;
                }

                VerticalLayout {
                    alignment: center;
                    LinkButton {
                        label: I18n.t("common.settings");
                        clicked => { root.action("settings"); }
                    }
                }
            }
        }

        if root.data.error != "": VerticalLayout {
            padding-top: 12px;
            Notice {
                text: root.data.error;
            }
        }

        Rectangle { height: 22px; }

        // ── the buttons ──────────────────────────────────────────────
        HorizontalLayout {
            spacing: 18px;

            if root.data.step > 0: VerticalLayout {
                alignment: center;
                LinkButton {
                    label: I18n.t("montaje.back");
                    clicked => { root.action("back"); }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            if root.data.step == 2: VerticalLayout {
                alignment: center;
                Text {
                    text: I18n.t("montaje.newTimelines");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-sm;
                }
            }

            if root.data.step < 2: PillButton {
                primary: true;
                label: I18n.t("montaje.next");
                enabled: root.can-next;
                clicked => { root.action("next"); }
            }

            if root.data.step == 2: PillButton {
                primary: true;
                label: I18n.t("montaje.run");
                enabled: root.can-run;
                clicked => { root.action("run"); }
            }
        }
    }
}

// New project's "Montar con IA": off, one row with its switch; on, what
// the montage needs, the rest as the sheet's defaults - the frame is the
// project's shape - and "Rehacer" in the Montaje pane for everything else.
export component MontajeSection inherits VerticalLayout {
    in property <MontajeData> data;
    in property <bool> narrow;
    /// The project is being made: nothing changes under it.
    in property <bool> busy;
    /// The captions and the script are showing.
    property <bool> more;

    callback text-edited(field: string, value: string);
    callback choice-changed(field: string, value: int);
    callback action(name: string);

    FormRow {
        label: I18n.upper("montaje.withAi");
        stacked: root.narrow;
        last: !root.data.enabled;

        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                Toggle {
                    on: root.data.enabled;
                    toggled => {
                        if (!root.busy) {
                            Focus.release();
                            root.choice-changed("enabled", root.data.enabled ? 0 : 1);
                        }
                    }
                }
            }

            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: I18n.t("montaje.withAiNote");
                color: Theme.fg-muted;
                font-size: Theme.fs;
                wrap: word-wrap;
            }
        }
    }

    if root.data.enabled: FormRow {
        label: I18n.upper("montaje.material");
        stacked: root.narrow;

        MaterialField {
            material: root.data.material;
            note: root.data.material-note;
            edited(text) => { root.text-edited("material", text); }
            browse => { root.action("browse-material"); }
        }
    }

    if root.data.enabled: FormRow {
        label: I18n.upper("montaje.kind");
        stacked: root.narrow;

        KindField {
            data: root.data;
            changed(index) => { root.choice-changed("recipe", index); }
        }
    }

    if root.data.enabled: FormRow {
        label: I18n.upper("montaje.request");
        stacked: root.narrow;
        last: !root.more && root.data.engine-ok;

        VerticalLayout {
            spacing: 8px;

            PlainInput {
                text: root.data.request;
                placeholder: I18n.t("montaje.requestPlaceholder");
                size: Theme.fs;
                edited(text) => { root.text-edited("request", text); }
            }

            // The captions and the script, folded: the sheet is tall
            // enough with the project's own rows above them.
            if !root.more: HorizontalLayout {
                alignment: start;
                LinkButton {
                    label: I18n.t("montaje.moreOptions");
                    clicked => { root.more = true; }
                }
            }
        }
    }

    if root.data.enabled && root.more: FormRow {
        label: I18n.upper("montaje.captions");
        stacked: root.narrow;

        CaptionsChoice {
            current: root.data.captions;
            narrow: root.narrow;
            changed(index) => { root.choice-changed("captions", index); }
        }
    }

    if root.data.enabled && root.more: FormRow {
        label: I18n.upper("montaje.script");
        stacked: root.narrow;
        last: root.data.engine-ok;

        ScriptField {
            script: root.data.script;
            action(name) => { root.action(name); }
        }
    }

    if root.data.enabled && !root.data.engine-ok: HorizontalLayout {
        padding-top: 4px;
        padding-bottom: 8px;
        spacing: 12px;

        Notice {
            horizontal-stretch: 1;
            text: root.data.engine-note;
        }

        VerticalLayout {
            alignment: center;
            LinkButton {
                label: I18n.t("common.settings");
                clicked => { root.action("settings"); }
            }
        }
    }
}
